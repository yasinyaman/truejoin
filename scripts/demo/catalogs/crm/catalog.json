  "examples": {
    "target_vs_actual_per_branch": {
      "name": "target_vs_actual_per_branch",
      "question": {
        "texts": {
          "en": "Target and actual amount per branch city",
          "tr": "Şube şehri bazında hedef ve gerçekleşen tutar"
        }
      },
      "sql": "SELECT s.sehir, h.hedef_tutar AS hedef, SUM(i.tutar) AS gerceklesen, SUM(i.tutar) / h.hedef_tutar AS gerceklesme_orani FROM smoke.islemler i JOIN smoke.musteriler m ON i.musteri_id = m.musteri_id JOIN smoke.subeler s ON m.sube_kodu = s.sube_kodu JOIN crm.sube_hedefleri h ON h.sube_kodu = s.sube_kodu GROUP BY s.sehir, h.hedef_tutar ORDER BY s.sehir",
      "description": {
        "texts": {}
      },
      "tables": [
        "smoke.islemler",
        "smoke.musteriler",
        "smoke.subeler",
        "crm.sube_hedefleri"
      ],
      "certified": true
    },
    "amount_per_segment": {
      "name": "amount_per_segment",
      "question": {
        "texts": {
          "en": "Transaction amount per customer segment",
          "tr": "Müşteri segmenti bazında işlem tutarı"
        }
      },
      "sql": "SELECT g.segment, COUNT(DISTINCT g.musteri_id) AS musteri, SUM(i.tutar) AS toplam FROM smoke.islemler i JOIN crm.musteri_segmentleri g ON g.musteri_id = i.musteri_id GROUP BY g.segment ORDER BY g.segment",
      "description": {
        "texts": {}
      },
      "tables": [
        "smoke.islemler",
        "crm.musteri_segmentleri"
      ],
      "certified": true
    }
  }

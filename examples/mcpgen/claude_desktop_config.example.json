{
  "mcpServers": {
    "petstore-api": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/truejoin",
        "python",
        "examples/mcpgen/run_mcp_server.py",
        "examples/mcpgen/petstore/output/petstore_server.json"
      ]
    },
    "github-api": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/truejoin",
        "python",
        "examples/mcpgen/run_mcp_server.py",
        "examples/mcpgen/github/output/github_server.json"
      ]
    },
    "ecommerce-api": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/truejoin",
        "python",
        "examples/mcpgen/run_mcp_server.py",
        "examples/mcpgen/custom/output/ecommerce_mcp_server.json"
      ]
    },
    "todo-api": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/truejoin",
        "python",
        "examples/mcpgen/run_mcp_server.py",
        "examples/mcpgen/postman/output/todo_mcp_server.json"
      ]
    }
  }
}
